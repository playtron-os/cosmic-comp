#!/bin/bash
# Fast, atomic logout for the persistent-compositor model.
#
# Panels call THIS instead of `loginctl terminate-user`: terminate-user first spends
# seconds deactivating user@UID (staggered teardown / flicker) before the desktop
# dies, and it would also end the user's ssh sessions. Here we end the desktop session
# IMMEDIATELY — SIGTERM cosmic-session (the greetd session leader), which reaps its
# components and lets greetd return to the greeter at once — then close the apps.
#
# Cleanup runs via `systemd-run --user`, NOT a backgrounded subshell: `&` leaves the child
# in the session cgroup, so logind kills it during teardown before it does anything.
#
# Apps are stopped by SLICE rather than by stopping user@UID: logind keeps the user manager
# alive while the user has any other session, so stopping it silently fails whenever they are
# also on ssh. app.slice holds the apps; session.slice (user bus, pipewire) keeps running, and
# agentos-session-launch re-starts default.target on the next login.
set -u
uid=$(id -u)

# Detach FIRST so the cleanup survives the teardown triggered below. background.slice, not the
# default app.slice — the cleanup stops app.slice, and would otherwise kill itself mid-stop.
systemd-run --user --no-block --quiet --slice=background.slice --unit=agentos-logout-cleanup -- \
    /bin/bash -c 'for _ in $(seq 1 20); do
                      pgrep -u "$(id -u)" -x cosmic-session >/dev/null || break
                      sleep 0.1
                  done
                  pkill -KILL -u "$(id -u)" -x cosmic-session 2>/dev/null
                  systemctl --user stop app.slice' 2>/dev/null

# End the desktop session now. cosmic-session tears down its components and exits;
# greetd sees the session close and shows the greeter.
pkill -TERM -u "$uid" -x cosmic-session

exit 0
