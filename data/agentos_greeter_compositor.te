module agentos_greeter_compositor 1.2;

# Lets the greeter (xdm_t) reach the cosmic-comp wayland socket in /run/cosmic-comp for the
# global-compositor login under ENFORCING — that socket only, not all of /run. /run/cosmic-comp
# gets a PRIVATE type (cosmic_comp_runtime_t) via the .fc; the socket + wayland-N.lock inherit it
# through the type_transitions below. `file_type` keeps the unconfined compositor + desktop
# working, so only xdm_t needs an explicit rule.

require {
	attribute file_type;
	type xdm_t;
	type init_t;
	type unconfined_service_t;
	type unconfined_t;
	class dir search;
	class sock_file { getattr write };
	class file { getattr map read write };
}

# Private type for /run/cosmic-comp (dir, wayland socket, lock file).
type cosmic_comp_runtime_t;
typeattribute cosmic_comp_runtime_t file_type;

# The socket + lock are created at runtime inside the labeled dir; make them inherit the
# private type regardless of which domain cosmic-comp-global.service runs in.
type_transition init_t               cosmic_comp_runtime_t:sock_file cosmic_comp_runtime_t;
type_transition unconfined_service_t cosmic_comp_runtime_t:sock_file cosmic_comp_runtime_t;
type_transition unconfined_t         cosmic_comp_runtime_t:sock_file cosmic_comp_runtime_t;
type_transition init_t               cosmic_comp_runtime_t:file cosmic_comp_runtime_t;
type_transition unconfined_service_t cosmic_comp_runtime_t:file cosmic_comp_runtime_t;
type_transition unconfined_t         cosmic_comp_runtime_t:file cosmic_comp_runtime_t;

# The greeter reaches ONLY the compositor socket now.
allow xdm_t cosmic_comp_runtime_t:dir search;
allow xdm_t cosmic_comp_runtime_t:sock_file { getattr write };
allow xdm_t cosmic_comp_runtime_t:file { getattr map read write };

# Confined domain for the compositor process. Shipped PERMISSIVE (denials logged, not enforced):
# this pass only makes the domain ENTER. Harvest the allow set on-device, then flip to enforcing:
#   semodule -DB ; (login/logout/lock/launch apps) ; ausearch -m avc -c cosmic-comp | audit2allow ; semodule -B
# Verify entry: `ps -eZ | grep cosmic-comp` shows cosmic_comp_t, not unconfined_t.
#
# INVARIANT: entry is keyed to unconfined_t/unconfined_r (agentos-display maps __default__ ->
# unconfined_u; its ExecStart shell execs the labeled binary -> transition). If agentos-display is
# remapped to a confined seuser, add the parallel type_transition + `role <r> types cosmic_comp_t`,
# or the transition silently breaks.

require {
	attribute domain;
	attribute exec_type;
	role unconfined_r;
	class process transition;
	class file { entrypoint execute open };
}

# The compositor's own domain + the label for /usr/bin/cosmic-comp (see .fc).
type cosmic_comp_t;
type cosmic_comp_exec_t;
typeattribute cosmic_comp_t domain;
typeattribute cosmic_comp_exec_t exec_type, file_type;

# Enter cosmic_comp_t when the unconfined_t launch shell execs the labeled binary. The role
# carries over from the launcher (unconfined_r), so authorize that role to hold the type.
type_transition unconfined_t cosmic_comp_exec_t:process cosmic_comp_t;
allow unconfined_t cosmic_comp_t:process transition;
allow cosmic_comp_t cosmic_comp_exec_t:file { entrypoint read execute open getattr map };
role unconfined_r types cosmic_comp_t;

# The socket + lock the confined compositor creates in its runtime dir keep the private type.
type_transition cosmic_comp_t cosmic_comp_runtime_t:sock_file cosmic_comp_runtime_t;
type_transition cosmic_comp_t cosmic_comp_runtime_t:file cosmic_comp_runtime_t;

# ------------------------------------------------------------------------------------------
# Harvested allow set (on-device AVC capture, greeter + login). Incomplete: captured with
# dontaudit still ON and without a full app/game/lock/logout cycle, so KEEP permissive until a
# complete pass under `semodule -DB` shows no new denials.
# ------------------------------------------------------------------------------------------

require {
	type bin_t, shell_exec_t, xauth_exec_t, xserver_exec_t, systemd_systemctl_exec_t;
	type systemd_unit_file_t, usr_t, passwd_file_t, cgroup_t, kernel_t;
	type init_t, init_var_run_t, unconfined_t, snappy_var_lib_t, syslogd_var_run_t;
	type dri_device_t, event_device_t, user_tty_device_t, udev_var_run_t;
	type systemd_logind_t, systemd_logind_var_run_t, systemd_logind_sessions_t;
	type systemd_userdbd_t, systemd_userdbd_runtime_t, systemd_homed_t;
	type system_dbusd_t, system_dbusd_var_run_t, unconfined_dbusd_t, session_dbusd_tmp_t;
	type tmp_t, tmpfs_t, user_tmp_t, proc_t, rtkit_daemon_t;
	class dir { add_name create getattr open read remove_name search setattr watch write };
	class file { create getattr ioctl link lock map open read rename setattr unlink write execute execute_no_trans entrypoint };
	class lnk_file read;
	class sock_file { create setattr write };
	class chr_file { getattr ioctl map open read write };
	class unix_stream_socket { connectto getattr ioctl write };
	class unix_dgram_socket { connect create getopt setopt sendto write };
	class netlink_kobject_uevent_socket { bind create getattr getopt setopt };
	class filesystem getattr;
	class process { setsched setrlimit };
	class dbus { acquire_svc send_msg };
}

# GPU/KMS + input devices.
allow cosmic_comp_t dri_device_t:chr_file { getattr ioctl map open read write };
allow cosmic_comp_t event_device_t:chr_file { getattr ioctl read write };
allow cosmic_comp_t user_tty_device_t:chr_file { read write };

# Its own runtime dir: the socket, lock, and log.
# setattr: the runtime-dir gate sets/clears a POSIX ACL on this dir (see runtime_dir.rs).
allow cosmic_comp_t cosmic_comp_runtime_t:dir { add_name create getattr open read remove_name search setattr watch write };
allow cosmic_comp_t cosmic_comp_runtime_t:file { create getattr link lock map open read rename setattr unlink write };
allow cosmic_comp_t cosmic_comp_runtime_t:sock_file create;

# udev enumeration (device discovery + hotplug).
allow cosmic_comp_t udev_var_run_t:dir search;
allow cosmic_comp_t udev_var_run_t:file { getattr open read };
allow cosmic_comp_t self:netlink_kobject_uevent_socket { bind create getattr getopt setopt };

# logind (session/seat state) + userdb/homed lookups.
allow cosmic_comp_t systemd_logind_t:dbus send_msg;
allow cosmic_comp_t systemd_logind_var_run_t:dir search;
allow cosmic_comp_t systemd_logind_var_run_t:file { getattr open read };
allow cosmic_comp_t systemd_logind_sessions_t:dir search;
allow cosmic_comp_t systemd_logind_sessions_t:file { getattr open read };
allow cosmic_comp_t systemd_userdbd_t:unix_stream_socket connectto;
allow cosmic_comp_t systemd_userdbd_runtime_t:dir { getattr open read search };
allow cosmic_comp_t systemd_userdbd_runtime_t:lnk_file read;
allow cosmic_comp_t systemd_userdbd_runtime_t:sock_file write;
allow cosmic_comp_t systemd_homed_t:unix_stream_socket connectto;
allow cosmic_comp_t passwd_file_t:file { getattr open read };

# D-Bus (system + session bus).
allow cosmic_comp_t system_dbusd_t:{ dbus } send_msg;
allow cosmic_comp_t system_dbusd_t:unix_stream_socket connectto;
allow cosmic_comp_t system_dbusd_var_run_t:dir search;
allow cosmic_comp_t system_dbusd_var_run_t:sock_file write;
allow cosmic_comp_t unconfined_dbusd_t:dbus { acquire_svc send_msg };
allow cosmic_comp_t unconfined_dbusd_t:unix_stream_socket connectto;
allow cosmic_comp_t session_dbusd_tmp_t:sock_file write;

# Helpers it execs: the launch shell, xauth, Xwayland, systemctl (env import).
allow cosmic_comp_t bin_t:file { entrypoint execute execute_no_trans map };
allow cosmic_comp_t shell_exec_t:file { execute execute_no_trans map };
allow cosmic_comp_t xauth_exec_t:file { execute execute_no_trans map open read };
allow cosmic_comp_t xserver_exec_t:file { execute execute_no_trans map open read };
allow cosmic_comp_t systemd_systemctl_exec_t:file { execute execute_no_trans map open read };
allow cosmic_comp_t systemd_unit_file_t:dir getattr;

# Temp dirs (shm buffers, X sockets).
allow cosmic_comp_t tmp_t:dir add_name;
allow cosmic_comp_t tmp_t:file { create open write };
allow cosmic_comp_t tmpfs_t:file { map read write };
allow cosmic_comp_t tmpfs_t:filesystem getattr;
allow cosmic_comp_t user_tmp_t:dir { add_name search };
allow cosmic_comp_t user_tmp_t:file { map write };
allow cosmic_comp_t user_tmp_t:sock_file { create setattr };

# systemd notify, cgroup + /proc reads, misc.
allow cosmic_comp_t kernel_t:unix_dgram_socket sendto;
allow cosmic_comp_t kernel_t:unix_stream_socket connectto;
allow cosmic_comp_t self:unix_dgram_socket { connect create getopt setopt write };
allow cosmic_comp_t self:process { setsched setrlimit };
allow cosmic_comp_t proc_t:file { open read };
allow cosmic_comp_t rtkit_daemon_t:dbus send_msg;   # realtime scheduling for the render thread
allow cosmic_comp_t cgroup_t:dir search;
allow cosmic_comp_t cgroup_t:file read;
allow cosmic_comp_t cgroup_t:filesystem getattr;
allow cosmic_comp_t init_t:dir search;
allow cosmic_comp_t init_t:file { getattr ioctl open read };
allow cosmic_comp_t init_t:lnk_file read;
allow cosmic_comp_t init_t:unix_stream_socket { getattr ioctl write };
allow cosmic_comp_t init_var_run_t:dir search;
allow cosmic_comp_t init_var_run_t:sock_file write;
allow cosmic_comp_t unconfined_t:dir search;
allow cosmic_comp_t unconfined_t:file { getattr ioctl open read };
allow cosmic_comp_t syslogd_var_run_t:dir search;
allow cosmic_comp_t syslogd_var_run_t:sock_file write;
allow cosmic_comp_t snappy_var_lib_t:dir search;
allow cosmic_comp_t usr_t:dir watch;

# Inbound: logind talks back, and the greeter connects to the compositor socket.
allow systemd_logind_t cosmic_comp_t:dbus send_msg;
allow xdm_t cosmic_comp_t:unix_stream_socket connectto;

# Log, don't block, until the harvested allow set above is complete.
permissive cosmic_comp_t;
