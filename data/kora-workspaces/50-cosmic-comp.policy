# What an app in a Kora workspace may call on game mode, for kora-workspaces'
# router: anything not listed, a method added later too, is refused to apps.
# The router vouches for the app behind each connection; AttestPeer is its own.
guard    inc.kora.GameMode
attest   inc.kora.GameMode /inc/kora/GameMode inc.kora.GameMode
upstream inc.kora.GameMode inc.kora.GameMode EnterGameMode
upstream inc.kora.GameMode inc.kora.GameMode ExitGameMode
upstream inc.kora.GameMode inc.kora.GameMode RegisterGameProcess
upstream inc.kora.GameMode inc.kora.GameMode SetFpsLimit
upstream inc.kora.GameMode inc.kora.GameMode SetScaling
upstream inc.kora.GameMode inc.kora.GameMode SetScalingFilter
upstream inc.kora.GameMode inc.kora.GameMode SetSharpness
upstream inc.kora.GameMode inc.kora.GameMode SetTearing
upstream inc.kora.GameMode inc.kora.GameMode SetVrr
upstream inc.kora.GameMode inc.kora.GameMode SetHdr
upstream inc.kora.GameMode inc.kora.GameMode SetOverlay
upstream inc.kora.GameMode inc.kora.GameMode SetOverlayKeyboard
upstream inc.kora.GameMode inc.kora.GameMode Screenshot
upstream inc.kora.GameMode inc.kora.GameMode StartRecording
upstream inc.kora.GameMode inc.kora.GameMode StopRecording
upstream inc.kora.GameMode inc.kora.GameMode AppFrametimeNs
