#!/bin/sh
# agentos-polkit-tier <action-id> — print "<allow_active> <allow_any>" for an action.
# Used by 50-agentos-desktop.rules. Prints nothing if the action is unknown.
[ -n "$1" ] || exit 1
exec awk -v id="$1" '
  /<action id=/ { in_a = index($0, "\"" id "\"") > 0 }
  in_a && match($0, /<allow_active>[^<]*/) { act = substr($0, RSTART+14, RLENGTH-14) }
  in_a && match($0, /<allow_any>[^<]*/)    { any = substr($0, RSTART+11, RLENGTH-11) }
  in_a && /<\/action>/ { exit }
  END { if (act != "" || any != "") print act, any }
' /usr/share/polkit-1/actions/*.policy
